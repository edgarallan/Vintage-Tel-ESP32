# Configurazione di base. Ogni riga qui e' una decisione, non un default copiato.

# --- Flash e partizioni -----------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Bluetooth --------------------------------------------------------------
# Classic senza BLE: HFP vive solo su BR/EDR, e il BLE costerebbe flash e RAM
# per una radio che questo progetto non usa mai.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Ruolo Hands-Free: il telefono e' il vivavoce, il cellulare e' l'Audio Gateway.
# Compilare anche il ruolo AG sarebbe flash sprecata.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=n

# Vincolo #2: l'audio SCO passa da vHCI, non dal percorso PCM hardware.
# Il Wide Band Speech (mSBC 16 kHz) dipende da questa scelta — vedi
# components/bt/host/bluedroid/Kconfig.in: BT_HFP_WBS_ENABLE depends on
# BT_HFP_AUDIO_DATA_PATH_HCI. Sul percorso PCM non passerebbe alcun dato.
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_WBS_ENABLE=y

# Rubrica scaricata dal cellulare invece che digitata a mano.
CONFIG_BT_PBAC_ENABLED=y
